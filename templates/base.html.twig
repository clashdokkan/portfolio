<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="https://bootswatch.com/5/vapor/bootstrap.min.css">
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# CORRECTION 1 : tout le CSS est dans le <head>, plus de <style> après le </main> #}
        <style>
            .centre {
                text-align: center;
            }
            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }
            main {
                flex: 1;
            }
            .bton {
                position: fixed;
                bottom: 20px;
                right: 20px;
                display: inline-block;
                padding: 12px 24px;
                background-color: #3498db;
                color: white;
                text-decoration: none;
                border: none;
                border-radius: 80px;
                font-size: 16px;
                cursor: pointer;
                transition: background 0.3s ease;
            }
        </style>
    </head>
    <body>

        {# CORRECTION 2 : la <nav> est EN DEHORS du <main>, le <main> englobe le contenu des pages #}
        <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_home') }}">Accueil</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor02" aria-controls="navbarColor02" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor02">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            {# CORRECTION 3 : utilisation de path() au lieu des URLs en dur #}
                            <a class="nav-link" href="{{ path('app_blog') }}">A propos de moi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_cv') }}">CV</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_competence') }}">Compétences</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_plus') }}">Pour en savoir plus</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        {# CORRECTION 2 (suite) : le <main> est ici, autour du contenu réel #}
        <main>
            {# CORRECTION 3 : path() au lieu de l'URL en dur pour le bouton retour #}
            <button onclick="window.location.href='{{ path('app_home') }}';" class="bton">retour</button>
            {% block body %}{% endblock %}
        </main>

        <footer>
            <div class="centre" style="font-size: 30px;">
                <p>2026 – LAURET Alexandre – BUT Réseaux et Télécommunications</p>
            </div>
        </footer>

    </body>
</html>
