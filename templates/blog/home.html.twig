{% extends 'base.html.twig' %}

{% block title %}Bienvenue{% endblock %}

{% block body %}
<style>
    .btn-nav {
        display: inline-block;
        padding: 20px 40px;
        background-color: #3498db;
        color: white;
        text-decoration: none;
        border: none;
        border-radius: 80px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease;
    }
    .btn-nav:hover {
        background-color: #079589ff;
        color: white;
    }

    {# CORRECTION 1 : remplacement du positionnement absolu par flexbox, bien plus solide #}
    .accueil-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        padding: 3rem 1rem;
        text-align: center;
    }
    .accueil-titre {
        margin-bottom: 1rem;
    }
    .accueil-boutons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
    }
    .accueil-carte {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        max-width: 220px;
    }
    .accueil-carte p {
        font-size: 0.95rem;
        color: #ccc;
    }
</style>

<div class="accueil-wrapper">

    <div class="accueil-titre">
        <h1 style="font-size: 3rem;">Bienvenue sur mon site !</h1>
        <h2 style="font-size: 1.4rem;">Par où voulez-vous commencer :</h2>
    </div>

    {# CORRECTION 2 : path() au lieu des URLs en dur #}
    {# CORRECTION 3 : suppression du </div> orphelin qui traînait ligne 74 #}
    <div class="accueil-boutons">

        <div class="accueil-carte">
            <a href="{{ path('app_blog') }}" class="btn-nav">Ma présentation</a>
            <p>Une courte présentation de moi.</p>
        </div>

        <div class="accueil-carte">
            <a href="{{ path('app_cv') }}" class="btn-nav">Accéder au CV</a>
            <p>Accès et téléchargement de mon CV.</p>
        </div>

        <div class="accueil-carte">
            <a href="{{ path('app_competence') }}" class="btn-nav">Mes Compétences</a>
            <p>Ce que j'ai appris grâce au BUT Réseaux et Télécommunications.</p>
        </div>

        <div class="accueil-carte">
            <a href="{{ path('app_plus') }}" class="btn-nav">En savoir plus sur moi</a>
            <p>Découvrir mes passions et mes passe-temps.</p>
        </div>

    </div>
</div>

{% endblock %}
